
PROJECT_NAME="Academia-Industry Collaboration & AI Placement Portal"
DATABASE_URL="sqlite+aiosqlite:///./portal.db"

# Put your own Groq API Key below (Get from https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# JWT Auth Keys
JWT_SECRET_KEY="your_jwt_secret_key_here"
JWT_REFRESH_SECRET_KEY="your_jwt_refresh_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
